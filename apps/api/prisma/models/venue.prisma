model Venue {
  id            String      @id @default(cuid())
  venueId       String      @unique
  slug          String      @unique

  name          String

  city          String

  capacity      Int?

  status        VenueStatus

  teams         Team[]
  matches       Match[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}