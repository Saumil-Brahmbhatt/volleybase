model MatchEvent {
  id            String      @id @default(cuid())

  eventId       String      @unique

  matchId       String
  matchSetId    String

  teamId        String

  playerId      String?

  eventType     EventType
  eventTime     DateTime

  match        Match @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  matchSet     MatchSet @relation(fields: [matchSetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([matchId])
  @@index([matchSetId])
}