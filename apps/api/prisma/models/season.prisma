model Season {
  id             String        @id @default(cuid())

  seasonId       String        @unique

  competitionId  String

  name           String

  seasonYear     Int

  startDate      DateTime

  endDate        DateTime

  status         SeasonStatus

  competition    Competition   @relation(feilds:[competitionId],refrences[id])

  playerSeasons  PlayerSeason[]
  matches        Match[]
  standings      Standing[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([competitionId])
}