model Season {
  id             String        @id @default(cuid())

  seasonId       String        @unique

  competitionId  String

  name           String
  shortName      String?

  seasonYear     Int

  slug           String        @unique

  startDate      DateTime
  endDate        DateTime

  status         SeasonStatus

  competition    Competition   @relation(fields: [competitionId], references: [competitionId], onDelete: Restrict, onUpdate: Cascade)

  playerSeasons  PlayerSeason[]
  matches        Match[]
  standings      Standing[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([competitionId])
}