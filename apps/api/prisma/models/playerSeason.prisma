model PlayerSeason {
  id                 String      @id @default(cuid())

  playerSeasonId     String      @unique

  playerId           String

  teamId             String

  seasonId           String

  jerseyNumber       Int

  isCaptain          Boolean @default(false)

  isViceCaptain      Boolean @default(false)

  isForeignPlayer    Boolean @default(false)

  joinedAt           DateTime?

  leftAt             DateTime?

  status             PlayerStatus

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}