model PlayerSeason {
  id                 String      @id @default(cuid())

  playerSeasonId     String      @unique

  playerId           String

  teamId             String

  seasonId           String

  jerseyNumber       Int

  isCaptain          Boolean     @default(false)

  isViceCaptain      Boolean     @default(false)

  isForeignPlayer    Boolean     @default(false)

  joinedAt           DateTime?

  leftAt             DateTime?

  status             PlayerStatus @default(ACTIVE)

  player             Player      @relation(fields: [playerId], references: [playerId], onDelete: Restrict, onUpdate: Cascade)
  team               Team        @relation(fields: [teamId], references: [teamId], onDelete: Restrict, onUpdate: Cascade)
  season             Season      @relation(fields: [seasonId], references: [seasonId], onDelete: Restrict, onUpdate: Cascade)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([playerId])
  @@index([teamId])
  @@index([seasonId])

  @@unique([playerId, seasonId])
  @@unique([teamId, seasonId, jerseyNumber])
}