model MatchSet {
  id              String      @id @default(cuid())

  matchSetId      String      @unique

  matchId         String

  setNumber       Int

  homeScore       Int @default(0)
  awayScore       Int @default(0)

  durationMinutes Int?

  winnerTeamId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}