model MatchSet {
  id              String      @id @default(cuid())

  matchSetId      String      @unique

  matchId         String

  setNumber       Int

  homeScore       Int @default(0)
  awayScore       Int @default(0)

  durationMinutes Int?

  winnerTeamId    String?
  
  match           Match @relation(fields: [matchId], references: [matchId], onDelete: Restrict, onUpdate: Cascade)

  events          MatchEvent[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([matchId])
}