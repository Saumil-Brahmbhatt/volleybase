model Team {
  id               String      @id @default(cuid())

  teamId           String      @unique

  slug             String      @unique

  organizationId   String?

  homeVenueId      String?

  name             String
  shortName        String
  abbreviation     String

  city             String?

  foundedYear      Int?

  status           TeamStatus

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}